{
  "expo": {
    "name": "CondoTrack",
    "slug": "condotrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#6D28D9"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.condotrack.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Usado para escanear QR Codes de entregas e fotografar volumes recebidos.",
        "NSPhotoLibraryUsageDescription": "Usado para salvar fotos das entregas.",
        "UIBackgroundModes": ["fetch", "remote-notification"]
      }
    },
    "android": {
      "package": "br.com.condotrack.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Usado para escanear QR Codes de entregas."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6D28D9",
          "sounds": ["./assets/notification.wav"]
        }
      ]
    ],
    "scheme": "condotrack",
    "experiments": {
      "typedRoutes": true
    }
  }
}
